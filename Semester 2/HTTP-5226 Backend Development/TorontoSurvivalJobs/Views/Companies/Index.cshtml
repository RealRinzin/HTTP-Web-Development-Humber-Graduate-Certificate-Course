@model IEnumerable<TorontoSurvivalJobs.Models.Company>

@{
    ViewData["Title"] = "Categories - Toronto Jobs";
}
<div class="w-full md:w-2/3 lg:w-3/4 mx-auto ">
    @if (TempData["ScrapeMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["ScrapeMessage"]
        </div>
    }
    <p>
        <a asp-action="Create" class="btn btn-primary">Add Company</a>
    </p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-6">
        @foreach (var company in Model)
        {
            <div
                class="bg-white p-4 sm:p-5 rounded-2xl border border-gray-100 shadow-sm flex items-center justify-between hover:shadow-md transition">
                <div class="flex items-center space-x-4">
                    <div
                        class="w-12 h-12 bg-gray-100 rounded-xl flex items-center justify-center text-[10px] font-bold text-gray-400 uppercase tracking-widest shrink-0">
                    <img src="@company?.Logo" alt="">
                    </div>
                    <div>
                        <h3 class="text-sm font-bold text-gray-900">
                            <a href="/jobs/details/">
                                @company.Name
                            </a>
                        </h3>
                        <p class="text-xs font-medium text-gray-500 mt-0.5">Total Jobs - @company.Jobs.Count</p>
                    </div>
                </div>
                <div class="flex items-center space-x-4">
                    <span
                    class="bg-[#EBF4EC] text-[#2D6A4F] text-[9px] font-bold tracking-wider px-2.5 py-1 rounded-full uppercase">@company.Location</span>
                    <span class="text-xs font-semibold text-gray-600 hidden sm:inline">
                    </span>
                </div>
            </div>
        }
    </div>
</div>
