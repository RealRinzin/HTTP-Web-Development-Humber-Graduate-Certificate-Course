@model IEnumerable<TorontoSurvivalJobs.Models.Job>

@{
    ViewData["Title"] = "Toronto Jobs";
}

<div class="max-w-7xl mx-auto px-6 py-10 w-full space-y-6">

    <!-- Notification Toast -->
    @if (TempData["ScrapeMessage"] != null)
    {
        <div
            class="bg-brand-pill text-brand-pillText border border-brand-green/20 px-4 py-3 rounded-xl text-sm font-medium flex items-center justify-between shadow-sm">
            <span>@TempData["ScrapeMessage"]</span>
            <button type="button" class="text-brand-pillText/70 hover:text-brand-pillText"
                    onclick="this.parentElement.remove()">✕</button>
        </div>
    }

    <!-- Header & Action Row -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="flex flex-col gap-2">
            <a asp-action="Create" asp-controller="jobs" class="bg-emerald-600 text-white py-2 px-4 w-fit font-bold rounded ">Add Job</a>
            <p class="text-xs font-mono text-brand-muted uppercase tracking-wider mt-1">Manage current job listings</p>
        </div>
        <div>
            <a asp-action="Create"
               class="inline-flex items-center space-x-2 bg-brand-green hover:bg-brand-greenHover text-white text-sm font-medium px-5 py-2.5 rounded-full transition-all shadow-sm">
                <span>+</span>
                <span>Add Job</span>
            </a>
        </div>
    </div>

    <!-- Job Table Card -->
    <div class="bg-brand-card rounded-2xl border border-brand-border/80 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <!-- Table Header -->
                <thead>
                    <tr
                        class="border-b border-brand-border/80 bg-brand-bg/40 text-[11px] font-mono text-brand-muted uppercase tracking-wider">
                        <th class="py-4 px-6 font-semibold">Title</th>
                        <th class="py-4 px-4 font-semibold">Company</th>
                        <th class="py-4 px-4 font-semibold">Location</th>
                        <th class="py-4 px-4 font-semibold">Type</th>
                        <th class="py-4 px-4 font-semibold">Experience</th>
                        <th class="py-4 px-4 font-semibold">Salary</th>
                        <th class="py-4 px-4 font-semibold">Category</th>
                        <th class="py-4 px-6 font-semibold text-right">Actions</th>
                    </tr>
                </thead>

                <!-- Table Body -->
                <tbody class="divide-y divide-brand-border/50 text-sm text-brand-text">
                    @foreach (var job in Model)
                    {
                        <tr class="hover:bg-brand-bg/30 transition-colors group">
                            <!-- Job Title -->
                            <td
                                class="py-4 px-6 font-semibold text-brand-text group-hover:text-brand-green transition-colors">
                                @job.Title
                            </td>

                            <!-- Company -->
                            <td class="py-4 px-4 font-medium text-brand-text/90">
                                @(job.Company?.Name ?? "—")
                            </td>

                            <!-- Location -->
                            <td class="py-4 px-4 text-brand-muted text-xs">
                                @(job.Location?.Name ?? "—")
                            </td>

                            <!-- Job Type Badge -->
                            <td class="py-4 px-4 whitespace-nowrap">
                                <span
                                    class="bg-brand-pill text-brand-pillText text-xs font-mono px-2.5 py-1 rounded-md font-medium">
                                    @(job.JobType ?? "N/A")
                                </span>
                            </td>

                            <!-- Experience Level -->
                            <td class="py-4 px-4 text-brand-muted text-xs">
                                @(job.ExperienceLevel ?? "—")
                            </td>

                            <!-- Salary -->
                            <td class="py-4 px-4 font-mono text-xs font-medium text-brand-text whitespace-nowrap">
                                @if (job.SalaryMin.HasValue && job.SalaryMax.HasValue)
                                {
                                    @($"{job.SalaryMin:C0} - {job.SalaryMax:C0}")
                                }
                                else if (job.SalaryMin.HasValue)
                                {
                                    @($"{job.SalaryMin:C0}+")
                                }
                                else
                                {
                                    <span class="text-brand-muted font-sans italic">Not specified</span>
                                }
                            </td>

                            <!-- Category -->
                            <td class="py-4 px-4 text-brand-muted text-xs">
                                @(job.Category?.Name ?? "—")
                            </td>

                            <!-- Actions -->
                            <td class="py-4 px-6 text-right whitespace-nowrap">
                                <div class="inline-flex items-center space-x-1.5">
                                    <!-- View Details -->
                                    <a asp-action="Details" asp-controller="jobs" asp-route-id="@job.JobId"
                                       title="View Details"
                                       class="w-8 h-8 rounded-full border border-brand-border flex items-center justify-center text-brand-muted hover:text-brand-text hover:bg-stone-100 transition-all">
                                        <i class="fa-solid fa-eye text-xs"></i>
                                    </a>

                                    <!-- Edit -->
                                    <a asp-action="Edit" asp-controller="jobs" asp-route-id="@job.JobId" title="Edit Job"
                                       class="w-8 h-8 rounded-full border border-brand-border flex items-center justify-center text-brand-muted hover:text-brand-green hover:border-brand-green/40 hover:bg-brand-pill/50 transition-all">
                                        <i class="fa-solid fa-pen-to-square text-xs"></i>
                                    </a>

                                    <!-- Delete -->
                                    <a asp-action="Delete" asp-controller="jobs" asp-route-id="@job.JobId"
                                       title="Delete Job"
                                       class="w-8 h-8 rounded-full border border-brand-border flex items-center justify-center text-brand-muted hover:text-rose-600 hover:border-rose-200 hover:bg-rose-50 transition-all">
                                        <i class="fa-solid fa-trash text-xs"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>