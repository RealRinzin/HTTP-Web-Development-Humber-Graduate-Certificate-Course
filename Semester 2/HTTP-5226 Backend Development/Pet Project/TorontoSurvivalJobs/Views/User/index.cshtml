@model List<User>
<div class="flex justify-center">
    <div class="w-2/6 my-6">
        <div class="flex justify-end my-2">
            <a href="/user/add" class="bg-blue-500 text-white py-1 px-2 rounded">Add New User +</a>
        </div>
        <table class="table-fixed w-full">
            <thead class="bg-gray-200 gap-4">
                <tr class="text-center">
                    <th>User ID</th>
                    <th>Name</th>
                    <th>Username</th>
                    <th>Role</th>
                    <th>Edit</th>
                    <th>Delete</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var users in Model)
                {
                    <tr class="text-center odd:bg-white even:bg-gray-100 ">
                        <td class="py-8">@users.id</td>
                        <td>@users.name</td>
                        <td>@users.username</td>
                        <td>@users.role</td>
                        <td>
                            <a href="/user/edit/@users.id">
                                <i class="fa-solid fa-pen-to-square text-blue-700 text-2xl"></i>
                            </a>
                        </td>
                        <td>
                            <form asp-action="Delete" asp-route-id="@users.id" method="post" style="display:inline;">
                                <button type="submit" class="btn btn-danger">
                                    <i class="fa-solid fa-trash text-red-600 text-2xl"></i>
                                </button>
                            </form>

                        </td>
                    </tr>

                }
            </tbody>
        </table>
    </div>

</div>