@model List<Job>
<div class="flex justify-center">
    <div class="w-1/2 my-6">
        <div class="flex justify-end my-2">
            <a href="/job/add" class="bg-blue-500 text-white py-1 px-2 rounded">Add New Job +</a>
        </div>
        <table class="table-fixed w-full">
            <thead class="bg-gray-200 gap-4">
                <tr class="text-center">
                    <th>Job ID</th>
                    <th>Logo</th>
                    <th>Role</th>
                    <th>Company</th>
                    <th>Type</th>
                    <th>Description</th>
                    <th>Link</th>
                    <th>Edit</th>
                    <th>Delete</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var jobs in Model)
                {
                    <tr class="text-center odd:bg-white even:bg-gray-100 ">
                        <td class="py-8">@jobs.id</td>
                        <td>
                            <img src="~/img/companies/@jobs.logo" alt="Logo"
                                 class="h-10 rounded-md border-gray-100/80 border" />
                        </td>
                        <td>@jobs.role</td>
                        <td>@jobs.company</td>
                        <td>@jobs.type</td>
                        <td>Description</td>
                        <td><a href="@jobs.apply" class="text-blue-600">Link</a> </td>
                        <td>
                            <a href="/job/edit/@jobs.id">
                                <i class="fa-solid fa-pen-to-square text-blue-700 text-2xl"></i>
                            </a>
                        </td>
                        <td>
                            <form asp-action="Delete" asp-route-id="@jobs.id" method="post" style="display:inline;">
                                <button type="submit" class="btn btn-danger">
                                    <i class="fa-solid fa-trash text-red-600 text-2xl"></i>
                                </button>
                            </form>

                        </td>
                    </tr>

                }
            </tbody>
        </table>
    </div>

</div>