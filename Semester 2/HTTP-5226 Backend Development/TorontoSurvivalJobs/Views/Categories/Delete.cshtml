@model TorontoSurvivalJobs.Models.Category

@{
    ViewData["Title"] = "Delete Category";
}

<h1>Delete Category</h1>

@if (Model.Jobs.Any())
{
    <div class="alert alert-danger">
        <strong>Cannot delete this category.</strong>
        <br />
        This category has @Model.Jobs.Count job(s) assigned to it.
    </div>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back to Categories
    </a>
}
else
{
    <div class="alert alert-warning">
        Are you sure you want to delete this category?
    </div>

    <div class="card">
        <div class="card-body">

            <h3>@Model.Name</h3>

            <form asp-action="Delete" method="post">

                <input type="hidden"
                       asp-for="CategoryId" />

                <button type="submit"
                        class="btn btn-danger">
                    Delete
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>
    </div>
}