@model MiniBlogRoleBase.Comment

@{
    ViewData["Title"] = "Edit Comment";
}

<div class="w-50 p-4 mx-auto shadow-sm rounded">
    <h3>Edit Comment</h3>

    <form asp-controller="Comment" asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="PostId" />

        <div class="mb-3">
            <label asp-for="Comments" class="form-label">Your Comment</label>
            <textarea asp-for="Comments" class="form-control" rows="4" required></textarea>
            <span asp-validation-for="Comments" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-controller="Post" asp-action="Detail" asp-route-id="@Model.PostId" class="btn btn-secondary">Cancel</a>
    </form>
</div>