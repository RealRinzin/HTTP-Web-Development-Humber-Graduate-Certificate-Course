@model BookingApp.Models.ViewModel
@{
    ViewData["Title"] = "Home Page";
}
<div class="container ">
    <div class="row">
        <div class="col">
            <h5 class="fs-3">Clients</h1>
                <a asp-action="Add" asp-controller="Client" class="btn btn-success">Create Client</a>
                <table class="table table-striped">
                    <thead class="thead-dark">
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">Name</th>
                            <th scope="col">Phone No</th>
                            <th scope="col">Email</th>
                            <th scope="col">Address</th>
                            <th scope="col">Edit</th>
                            <th scope="col">Delete</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int clientService = 1;
                        }
                        @foreach (var clients in Model.Clients)
                        {
                            <tr>
                                <th scope="row">@clientService</th>
                                <td>@clients.name</td>
                                <td>@clients.phone</td>
                                <td>@clients.email</td>
                                <td>@clients.address</td>
                                <th scope="col">
                                    <a asp-action="Edit" asp-controller="Client" asp-route-id="@clients.Id"><i
                                        class="fa fa-2x fa-pencil-square" aria-hidden="true"></i>
                                    </a>
                                </th>
                                <th scope="col">
                                    <form asp-action="Delete" asp-controller="Client" asp-route-id="@clients.Id"
                                          method="post">
                                        <button type="submit" class="btn btn-danger btn-sm"> <i class="fa  fa-trash"
                                                                                             aria-hidden="true"></i></button>
                                        </form>
                                    </th>
                                </tr>
                                clientService++;
                            }
                        </tbody>
                    </table>
                </div>
                <div class="col">
                    <h5 class="fs-3">Services</h1>
                        <a asp-action="Add" asp-controller="Service" class="btn btn-secondary">Add Service</a>
                        <table class="table table-striped">
                            <thead class="thead-dark">
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">Name</th>
                                    <th scope="col">Price</th>
                                    <th scope="col">Description</th>
                                    <th scope="col">Edit</th>
                                    <th scope="col">Delete</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int serviceIndex = 1;
                                }
                                @foreach (var services in Model.Services)
                                {
                                    <tr>
                                        <th scope="row">@serviceIndex</th>
                                        <td>@services.name</td>
                                        <td>@services.price</td>
                                        <td>@services.description</td>
                                        <th scope="col">
                                            <a asp-action="Edit" asp-controller="Service" asp-route-id="@services.Id"><i
                                                class="fa fa-2x fa-pencil-square" aria-hidden="true"></i></a>
                                            </th>
                                            <th scope="col">
                                                <form asp-action="Delete" asp-controller="Service" asp-route-id="@services.Id"
                                                      method="post">
                                                    <button type="submit" class="btn btn-sm btn-danger"> <i class="fa  fa-trash"
                                                                                                         aria-hidden="true"></i></button>
                                                    </form>
                                                </th>
                                            </tr>
                                            serviceIndex++;
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="row">
                            <div class="container mt-4">
                                <h2>Appointment List</h2>
                                <a asp-action="Add" asp-controller="Appointment" class="btn btn-secondary">Add Appointment</a>

                                <table class="table table-striped table-bordered mt-3">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>Client</th>
                                            <th>Service</th>
                                            <th>Date</th>
                                            <th>Time</th>
                                            <th>Last Updated</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.Appointments)
                                        {
                                            <tr>
                                                <td>@(item.Client != null ? item.Client.name : "N/A")</td>
                                                <td>@(item.Service != null ? item.Service.name : "N/A")</td>
                                                <td>@item.Date.ToString("yyyy-MM-dd")</td>
                                                <td>@item.Time.ToString(@"hh\:mm")</td>
                                                <td>@item.UpdatedAt.ToString("g")</td>
                                                <td>
                                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">
                                                        <i class="fa fa fa-pencil-square" aria-hidden="true"></i>
                                                    </a>
                                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger"
                                                       onclick="return confirm('Are you sure you want to delete this appointment?');">
                                                        <i class="fa  fa-trash" aria-hidden="true"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>

                            </div>
                        </div>