@model Client
<div class="w-25 p-3 mx-auto shadow-md">
            <h5 class="fs-2">Edit Client</h1>

    <form asp-action="Update" method="post">
        <input asp-for="Id" type="hidden" />
        <div>
            <label asp-for="name" class="form-label">Name</label>
            <input asp-for="name" class="form-control" />
            <span asp-validation-for="name" class="text-danger"></span>

        </div>
        <div>
            <label asp-for="email" class="form-label">Email</label>
            <input asp-for="email" asp-type="email" class="form-control" />
            <span asp-validation-for="email" class="text-danger"></span>

        </div>
        <div>
            <label asp-for="phone" class="form-label">Phone No</label>
            <input asp-for="phone" class="form-control" />
            <span asp-validation-for="phone" class="text-danger"></span>
        </div>

        <div>
            <label asp-for="address" class="form-label">Address</label>
            <input asp-for="address" class="form-control" />
            <span asp-validation-for="address" class="text-danger"></span>

        </div>
        <button class="btn btn-primary my-5">Update Client</button>
    </form>

</div>