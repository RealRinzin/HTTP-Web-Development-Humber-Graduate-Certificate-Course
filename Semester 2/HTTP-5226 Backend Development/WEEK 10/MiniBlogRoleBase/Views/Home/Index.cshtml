@model IEnumerable<MiniBlogRoleBase.Post>
@using System.Security.Claims

@{
    ViewData["Title"] = "Home Page";
}

<div class="container my-4">
    <div class="row">
        @if (Model == null || !Model.Any())
        {
            <div class="col-12">
                <p class="text-muted">No posts available.</p>
            </div>
        }
        else
        {
            @foreach (var post in Model)
            {
                <div class="col-md-3 my-3">
                    <div class="card h-100" style="width: 18rem;">
                        <img src="@post.FeaturedImage" class="card-img-top" alt="@post.Title">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@post.Title</h5>
                            <p class="card-text flex-grow-1">@post.Summary</p>

                            <div class="d-flex gap-2 align-items-center mt-3">
                                <!-- View Details -->
                                <a asp-controller="Post" asp-action="Detail" asp-route-id="@post.Id" class="btn btn-primary btn-sm">View</a>

                                @* Show Edit & Delete buttons only if user is authenticated and is the owner *@
                                @if (User.Identity?.IsAuthenticated == true && post.UserId == User.FindFirstValue(ClaimTypes.NameIdentifier))
                                {
                                    <a asp-controller="Post" asp-action="Edit" asp-route-id="@post.Id" class="btn btn-secondary btn-sm">Edit</a>

                                    <form asp-controller="Post" asp-action="Delete" asp-route-id="@post.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this post?');" class="d-inline">
                                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>