@{
    ViewData["Title"] = "Toronto Survival Jobs | Find the right jobs";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
        theme: {
        extend: {
        colors: {
        creamBg: '#FAF5EF',
        brandGreen: '#527863',
        brandDark: '#18181B',
        }
        }
        }
        }
    </script>
</head>

<body
    class="bg-[#FAF5EF] text-gray-900 font-sans antialiased min-h-screen flex flex-col justify-between selection:bg-emerald-200">
    <!-- Header Navigation -->
    <header class="max-w-7xl mx-auto w-full px-8 py-6 flex items-center justify-between">
        <div class="flex items-center space-x-10">
            <a href="/" class="text-xl font-black tracking-tight text-black">Toronto Survival Jobs  <span class="text-xs font-thin ">&copy; </span></a>
            <nav class="hidden md:flex space-x-8 text-xs font-medium text-gray-600">
                <a href="/jobs" class="hover:text-black transition">Jobs</a>
                <a href="/companies" class="hover:text-black transition">Companies</a>
                <a href="/categories" class="hover:text-black transition">Categories</a>
                <a href="/scraper" class="hover:text-black transition">Update Jobs</a>
            </nav>
        </div>
        <div class="flex items-center space-x-6 text-xs font-semibold">
            <a href="#" class="text-gray-800 hover:text-black transition">Post a Job</a>
            <a href="/dashboard/jobs" class="bg-[#18181B] text-white px-5 py-2.5 rounded-full hover:bg-gray-800 transition">Dashboard</a>
            </div>
        </header>
        <div class="max-w-7xl mx-auto w-full px-8 py-6 ">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
        <!-- Footer -->
        <footer
            class="max-w-7xl mx-auto w-full px-8 py-8 flex flex-col sm:flex-row items-center justify-between text-xs text-gray-500 space-y-4 sm:space-y-0">
            <div>
                <span class="font-black text-black text-sm block">Toronto Survival Jobs.</span>
                <span class="text-gray-400 mt-1 block text-[11px]">&copy; 2026 Index Job Portal. Built for better
                    work.</span>
                </div>
                <div class="flex items-center space-x-6 uppercase font-mono text-[10px] tracking-wider text-gray-500">
                    <a href="#" class="hover:text-black transition">TWITTER</a>
                    <a href="#" class="hover:text-black transition">LINKEDIN</a>
                    <a href="#" class="hover:text-black transition">RSS</a>
                </div>
            </footer>
    <script
      src="https://kit.fontawesome.com/f15d50a24d.js"
      crossorigin="anonymous"
    ></script>
        </body>

    </html>
