@model IEnumerable<MiniBlogRoleBase.Post>

@{
    ViewData["Title"] = "My Posts";
}

<div class="container my-4">
    <h2>My Posts</h2>
    <a asp-action="Add" class="btn btn-primary mb-3">Add New Post</a>

    <div class="row">
        @if (!Model.Any())
        {
            <p>You haven't created any posts yet.</p>
        }
        else
        {
            @foreach (var post in Model)
            {
                <div class="col-md-3 gap-3 my-3">
                    <div class="card" style="width: 18rem;">
                        <img src="@post.FeaturedImage" class="card-img-top" alt="Featured Image">
                        <div class="card-body">
                            <h5 class="card-title">@post.Title</h5>
                            <p class="card-text">@post.Summary</p>
                            <a href="#" class="btn btn-primary">View</a>
                            <a asp-action="Edit" asp-route-id="@post.Id" class="btn btn-secondary">Edit</a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>