extends layout
include ../Components/cards/job/index.pug
include ../Components/cards/country/index.pug
block content
    main.grid.grid-cols-2.gap-4.px-20.py-10
        div 
            h1.font-bold.text-lg.my-2 Recent Post Jobs
            each job in jobs 
                +JobCard(job)
        div 
            h1.font-bold.text-lg.my-2 G7 Countries
            each country in countries 
                +CountryCard(country)