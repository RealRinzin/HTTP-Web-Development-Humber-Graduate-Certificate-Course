@model TorontoSurvivalJobs.Models.Company

@{
    ViewData["Title"] = "Delete Company";
}

<h1>Delete Company</h1>

@if (Model.Jobs.Any())
{
    <div class="alert alert-danger">

        <strong>Cannot delete this company.</strong>

        <br />

        This company has
        @Model.Jobs.Count
        job(s) assigned to it.

    </div>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back to Companies
    </a>
}
else
{
    <div class="alert alert-warning">
        Are you sure you want to delete this company?
    </div>

    <div class="card">

        <div class="card-body">

            <h3>@Model.Name</h3>

            <p>
                @Model.Location
            </p>

            <form asp-action="Delete"
                  method="post">

                <input type="hidden"
                       asp-for="CompanyId" />

                <button type="submit"
                        class="btn btn-danger">
                    Delete
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>
}