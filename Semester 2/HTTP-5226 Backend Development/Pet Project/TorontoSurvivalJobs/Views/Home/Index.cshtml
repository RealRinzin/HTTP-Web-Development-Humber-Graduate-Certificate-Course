@model TorontoSurvivalJobs.Models.ViewModel
@{
    ViewData["Title"] = "Home Page";
}

<div class="bg-slate-100 p-20 w-100">
    <div class="flex flex-row justify-center ">
        <div class="">
            <h1 class="text-3xl font-bold py-4">Find Your First Surival Job in Toronto</h1>
            <p class="text-gray-500">Discover thousands of opportunities across Toronto's top employmers.</p>
            <p class="text-gray-500">Your career journey starts here</p>
            <div class="py-10">
                <div class="rounded-lg flex bg-white h-14 shadow-md items-center focus:outline focus:outline-gray-300">
                    <input type="text" class="border-none rounded-md px-6 h-14 w-full focus:outline-none" placeholder="Search...">
                    <button class="-m-10"><i class="fa-solid fa-magnifying-glass text-xl text-gray-600"></i></button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="w-2/6 mx-auto my-4">
    <h2 class="my-4 font-bold text-lg text-gray-600">Recent Job Posts</h2>
    <div class="grid grid-cols-1 gap-4">
        @foreach (var job in Model.Jobs)
        {
            <div class="flex gap-4 rounded-md shadow-sm my-2 bg-gray-100 p-5">
                <div>
                    <img src="~/img/companies/@job.logo" alt="Logo" class="rounded-md" style="width: 200px;;" />
                </div>
                <div class="flex flex-col gap-y-1">
                    <h1 class="font-bold text-gray-700 text-xl">
                        <a href="/job/detail/@job.id">
                            @job.role</a>
                        </h1>
                        <p class="font-semibold text-gray-500 text-lg">@job.company</p>
                        <div class="flex flex-row gap-2 my-2">
                            <p class="bg-blue-900 text-white rounded p-1 text-xs">@job.location</p>
                            <p class="bg-blue-500 text-white rounded p-1 text-xs">@job.type</p>
                        </div>
                        <p class="text-gray-800 my-2">
                            <a href="/job/detail/@job.id">
                                @job.description

                            </a>
                        </p>
                        <p class="text-xs text-gray-500 my-1 font-medium">@job.posted</p>
                    </div>
                </div>
            }

        </div>
    </div>