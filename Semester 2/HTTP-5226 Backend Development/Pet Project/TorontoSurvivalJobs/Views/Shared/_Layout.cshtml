@page
@* @model IndexModel *@
@{
    ViewData["Title"] = "INDEX - Find Work That Matters";
    Layout = null; // Remove or set to "_Layout" if using a shared layout
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        creamBg: '#FAF5EF',
                        brandGreen: '#527863',
                        brandDark: '#18181B',
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-[#FAF5EF] text-gray-900 font-sans antialiased min-h-screen flex flex-col justify-between selection:bg-emerald-200">
<!-- Header Navigation -->
    <header class="max-w-7xl mx-auto w-full px-8 py-6 flex items-center justify-between">
        <div class="flex items-center space-x-10">
            <a href="#" class="text-xl font-black tracking-tight text-black">INDEX.</a>
            <nav class="hidden md:flex space-x-8 text-xs font-medium text-gray-600">
                <a href="#" class="hover:text-black transition">Find Jobs</a>
                <a href="#" class="hover:text-black transition">Companies</a>
                <a href="#" class="hover:text-black transition">Salaries</a>
            </nav>
        </div>
        <div class="flex items-center space-x-6 text-xs font-semibold">
            <a href="#" class="text-gray-800 hover:text-black transition">Post a Job</a>
            <a href="#" class="bg-[#18181B] text-white px-5 py-2.5 rounded-full hover:bg-gray-800 transition">Sign In</a>
        </div>
    </header>
    <div >
        <main role="main" class="pb-3 min-h-screen">
            dasasdfsa
            @RenderBody()
        </main>
    </div>

<!-- Footer -->
    <footer class="max-w-7xl mx-auto w-full px-8 py-8 flex flex-col sm:flex-row items-center justify-between text-xs text-gray-500 space-y-4 sm:space-y-0">
        <div>
            <span class="font-black text-black text-sm block">INDEX.</span>
            <span class="text-gray-400 mt-1 block text-[11px]">&copy; 2026 Index Job Portal. Built for better work.</span>
        </div>
        <div class="flex items-center space-x-6 uppercase font-mono text-[10px] tracking-wider text-gray-500">
            <a href="#" class="hover:text-black transition">TWITTER</a>
            <a href="#" class="hover:text-black transition">LINKEDIN</a>
            <a href="#" class="hover:text-black transition">RSS</a>
        </div>
    </footer>

</body>
</html>