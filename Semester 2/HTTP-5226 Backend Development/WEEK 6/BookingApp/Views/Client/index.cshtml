@model List<Client>
    <a asp-action="Index" asp-controller="Home">Back to Home</a>
<h5 class="fs-3">Service List</h1>
    <a asp-action="Add" class="btn btn-success">Create Client</a>
    <table class="table table-striped">
        <thead class="thead-dark">
            <tr>
                <th scope="col">#</th>
                <th scope="col">Name</th>
                <th scope="col">Phone Number</th>
                <th scope="col">Email</th>
                <th scope="col">Address</th>
                <th scope="col">Edit</th>
                <th scope="col">Delete</th>
            </tr>
        </thead>
        <tbody>
            @{
                int index = 1;
            }

            @foreach (var clients in Model)
            {
                <tr>
                    <th scope="row">@index</th>
                    <td>@clients.name</td>
                    <td>@clients.phone</td>
                    <td>@clients.email</td>
                    <td>@clients.address</td>
                    <th scope="col">
                        <a asp-action="Edit" asp-route-id="@clients.Id"><i class="fa fa-2x fa-pencil-square" aria-hidden="true"></i></a>
                        </th>
                        <th scope="col">
                            <form asp-action="Delete" asp-route-id="@clients.Id" method="post">
                                <button type="submit"> <i class="fa  fa-trash" aria-hidden="true"></i></button>
                            </form>
                        </th>

                
                    </tr>
                    index++;

                }
            </tbody>
        </table>

