@model Job

<div class="flex justify-center">
    <div class="w-1/4 my-6">
        <h1 class="bg-blue-800 py-3 px-2 shadow-md text-xl text-white">Add New Job</h1>
        <form asp-action="Edit" method="post" class="flex flex-col gap-4 rounded-md shadow-md px-4 py-6">
            <div class="flex flex-col gap-2">
                <label asp-for="role" class="text-gray-500 px-1">Role Name</label>
                <input asp-for="role" class="border border-gray-200 w-full rounded-md px-4 py-1"
                       placeholder="Role Name" />
            </div>
            <div class="flex flex-col gap-2">
                <label asp-for="company" class="text-gray-500 px-1">Company</label>
                <input asp-for="company" class="border border-gray-200 w-full rounded-md px-4 py-1"
                       placeholder="Company Name" />
            </div>
            <div class="flex flex-col gap-2">
                <label asp-for="logo" class="text-gray-500 px-1">Logo Name</label>
                <input asp-for="logo" class="border border-gray-200 w-full rounded-md px-4 py-1"
                       placeholder="Logo Name" />
            </div>
            <div class="flex flex-col gap-2">
                <label asp-for="location" class="text-gray-500 px-1">Location</label>
                <input asp-for="location" class="border border-gray-200 w-full rounded-md px-4 py-1"
                       placeholder="Location Name" />
            </div>
            <div class="flex flex-col gap-2">
                <label asp-for="type" class="text-gray-500 px-1">Type</label>
                <input asp-for="type" class="border border-gray-200 w-full rounded-md px-4 py-1"
                       placeholder="Type Name" />
            </div>
            <div class="flex flex-col gap-2">
                <label asp-for="apply" class="text-gray-500 px-1">Apply</label>
                <input asp-for="apply" class="border border-gray-200 w-full rounded-md px-4 py-1"
                       placeholder="URL Link" />
            </div>
            <div class="flex flex-col gap-2">
                <label asp-for="description" class="text-gray-500 px-1">Description</label>
                <textarea asp-for="description" class="border border-gray-200 w-full rounded-md px-4 py-1"> </textarea>
            </div>
            <button type="submit" class="bg-blue-700 text-white px-3 py-2 w-full uppercase">Update Job </button>
        </form>
    </div>
</div>