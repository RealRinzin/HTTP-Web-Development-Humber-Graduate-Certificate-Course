@using System.Security.Claims
@model MiniBlogRoleBase.Post

@{
    ViewData["Title"] = Model.Title;
    var comments = ViewBag.Comments as List<MiniBlogRoleBase.Comment> ?? new List<MiniBlogRoleBase.Comment>();
}

<div class="container my-4">
    <div class="col-md-8 mx-auto">
        <!-- Post Content -->
        <h1>@Model.Title</h1>
        <img src="@Model.FeaturedImage" class="img-fluid rounded mb-3" alt="@Model.Title" />
        <p class="lead">@Model.Summary</p>
        <div>@Model.Description</div>

        <hr class="my-4" />

        <!-- Add Comment Form -->
        <h4>Leave a Comment</h4>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <form asp-controller="Comment" asp-action="Add" method="post" class="mb-4">
                <input type="hidden" name="postId" value="@Model.Id" />

                <div class="mb-2">
                    <label class="form-label fw-bold">Rating:</label>
                    <select name="rating" class="form-select w-auto d-inline-block ms-2">
                        <option value="5" selected>⭐⭐⭐⭐⭐ (5/5)</option>
                        <option value="4">⭐⭐⭐⭐ (4/5)</option>
                        <option value="3">⭐⭐⭐ (3/5)</option>
                        <option value="2">⭐⭐ (2/5)</option>
                        <option value="1">⭐ (1/5)</option>
                    </select>
                </div>

                <div class="mb-3">
                    <textarea name="commentText" class="form-control" rows="3" placeholder="Write a comment..."
                              required></textarea>
                </div>
                <button type="submit" class="btn btn-primary">Submit Comment</button>
            </form>
        }
        @foreach (var comment in comments)
        {
            <div class="card mb-2">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <strong>@(comment.User?.UserName ?? "Anonymous")</strong>
                            <!-- Render Star Rating -->
                            <div class="d-inline-block ms-2">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= comment.Rating)
                                    {
                                        <i class="bi bi-star-fill text-warning"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-star-fill text-secondary opacity-25"></i>
                                    }
                                }
                            </div>
                        </div>
                        <small class="text-muted">@comment.CreatedAt.ToString("MMM dd, yyyy HH:mm")</small>
                    </div>

                    <p class="card-text mt-2">@comment.Comments</p>

                    @* Owner / Admin controls *@
                    @if (User.Identity?.IsAuthenticated == true && (comment.UserId ==
                        User.FindFirstValue(ClaimTypes.NameIdentifier) || User.IsInRole("Admin")))
                    {
                        <div class="d-flex gap-2 mt-2">
                            <a asp-controller="Comment" asp-action="Edit" asp-route-id="@comment.Id"
                               class="btn btn-sm btn-outline-secondary">Edit</a>

                            <form asp-controller="Comment" asp-action="Delete" method="post"
                                  onsubmit="return confirm('Are you sure you want to delete this comment?');">
                                <input type="hidden" name="commentId" value="@comment.Id" />
                                <input type="hidden" name="postId" value="@Model.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>