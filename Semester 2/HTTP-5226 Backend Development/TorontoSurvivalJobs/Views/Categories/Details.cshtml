@model TorontoSurvivalJobs.Models.Category

@{
    ViewData["Title"] = "Category Details";
}

<h1>Category Details</h1>

<div class="card">
    <div class="card-body">

        <h2>@Model.Name</h2>

        <hr />

        <h4>Jobs in this category</h4>

        @if (Model.Jobs.Any())
        {
            <table class="table">

                <thead>
                    <tr>
                        <th>Job Title</th>
                        <th>Company</th>
                        <th>Location</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var job in Model.Jobs)
                    {
                        <tr>
                            <td>
                                @job.Title
                            </td>

                            <td>
                                @job.Company
                            </td>

                            <td>
                                @job.Location
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        }
        else
        {
            <p>
                No jobs in this category.
            </p>
        }

        <a asp-action="Index"
           class="btn btn-secondary">
            Back to Categories
        </a>

    </div>
</div>