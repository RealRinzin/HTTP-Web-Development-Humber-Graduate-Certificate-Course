@model IEnumerable<TorontoSurvivalJobs.Models.Job>

@{
    ViewData["Title"] = "Toronto Jobs";
}
<div class="w-full md:w-1/2 lg:w-1/2 mx-auto  ">
    @if (TempData["ScrapeMessage"] != null)
    {
        <div class="alert alert-success bg-[#EBF4EC] text-[#2D6A4F] w-fit px-4 py-1">
            @TempData["ScrapeMessage"]
        </div>
    }
    @foreach (var job in Model)
    {
        <div
            class="bg-white p-4 sm:p-5 rounded-2xl border border-gray-100 shadow-sm flex items-center justify-between hover:shadow-md transition my-8">
            <div class="flex items-center space-x-4">
                <div
                    class="w-12 h-12 bg-gray-100 rounded-xl flex items-center justify-center text-[10px] font-bold text-gray-400 uppercase tracking-widest shrink-0">
                    <img src="@job?.Company?.Logo" alt="">
                </div>
                <div>
                    <h3 class="text-sm font-bold text-gray-900">
                        <a href="/jobs/details/@job?.JobId">
                            @job?.Title
                        </a>
                    </h3>
                    <p class="text-sm font-medium text-gray-500 mt-0.5">@job?.Company?.Name</p>
                </div>
            </div>
            <div class="flex items-center space-x-4">
                <span
                class="bg-[#EBF4EC] text-[#2D6A4F] text-[9px] font-bold tracking-wider px-2.5 py-1 rounded-full uppercase">@job?.JobType</span>
                <span class="text-xs font-semibold text-gray-600 hidden sm:inline">
          @if (job.SalaryMin.HasValue && job.SalaryMax.HasValue)
            {
                @($"{job.SalaryMin:C} - {job.SalaryMax:C}")
            }
            else if (job.SalaryMin.HasValue)
            {
                @($"{job.SalaryMin:C}+")
            }
            else
            {
                <span>Not specified</span>
            }
                </span>
            </div>
        </div>
    }
</div>