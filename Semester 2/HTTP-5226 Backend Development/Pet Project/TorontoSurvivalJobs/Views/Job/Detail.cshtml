@model Job

@{
    ViewData["Title"] = "Testing";
}
<div class="flex justify-center">
    <div class="w-1/2 my-6">
        <div class="rounded-md shadow-md p-4">
            <div class="flex justify-between">
                <div class="flex flex-col gap-2">
                    <h1 class="text-xl font-extrabold text-gray-700">@Model.role</h1>
                    <p class="text-gray-500 font-semibold">@Model.company</p>
                    <p class="text-sm font-medium text-gray-500"><i class="fa-solid fa-location-dot"></i>
                        @Model.location</p>
                        <p class="text-sm text-gray-400">@Model.posted</p>
                    </div>
                    <img src="~/img/companies/@Model.logo" alt="Logo" class="h-20 rounded-md border-gray-100/80 border" />
                </div>
                <div class="mt-4 border-t border-gray-200 pt-4">
                    <a href="" class="bg-blue-600 text-white p-2 rounded">Apply this job</a>
                </div>
            </div>
            <article class="rounded-md shadow-md p-4 my-6">
                <h2 class="font-bold text-gray-700 border-b-gray-200 border-b py-2">Job Description & Responsibilities</h2>
                <p class="my-3">@Model.description</p>

            </article>
        </div>
    </div>